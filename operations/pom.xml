<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.vzwingma.finances.budget.serverless</groupId>
        <artifactId>services</artifactId>
        <version>26.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>operations</artifactId>
    <name>Opérations</name>
    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- TRANSITOIRE (AP004 T2.3) : les anciens dev/ et prod/ ne sont plus des ressources (profils Quarkus).
                     A retirer une fois dev/application.properties et prod/application.properties supprimés. -->
                <excludes>
                    <exclude>dev/**</exclude>
                    <exclude>prod/**</exclude>
                </excludes>
            </resource>
        </resources>
    </build>


    <dependencies>
        <dependency>
            <groupId>io.github.vzwingma.finances.budget.serverless</groupId>
            <artifactId>communs</artifactId>
            <version>26.0.0-SNAPSHOT</version>
        </dependency>
        <!-- Résilience des appels REST inter-services : retry restreint (AP004 T2.4, ADR-009) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
        </dependency>
        <!-- Tests d'intégration Mongo : MongoDB Testcontainers indépendant du profil Maven (version gérée par le BOM Quarkus) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mongodb</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
